{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/three-degrees",
      "destination": "/put-it-to-work/three-degrees",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/honest-questions/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
